# Copy this file to .env. Never commit .env.

# MySQL / Docker Compose
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=zhixun_campus
MYSQL_USERNAME=root
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

# Redis for login sessions and business cache
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Redis Stack vector database
REDIS_STACK_HOST=127.0.0.1
REDIS_STACK_PORT=6380
REDIS_STACK_PASSWORD=

# Nacos
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

# Elasticsearch 7
ELASTICSEARCH_URIS=http://127.0.0.1:9200

# Use the same JWT secret in user-service and item-service.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# AI service / Ollama
AI_SERVICE_URL=http://127.0.0.1:8083
AI_SERVICE_URI=http://127.0.0.1:8083
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5:1.5b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Service ports
GATEWAY_PORT=8080
USER_SERVICE_PORT=8081
ITEM_SERVICE_PORT=8082
AI_SERVICE_PORT=8083

# Local uploaded files (relative to the project root)
ITEM_IMAGE_PATH=./.data/item-images
