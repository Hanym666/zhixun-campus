<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhixun.item.mapper.ClaimMessageMapper">

    <resultMap id="MessageResultMap" type="com.zhixun.item.domain.ClaimMessage">
        <id column="id" property="id"/>
        <result column="claim_id" property="claimId"/>
        <result column="sender_id" property="senderId"/>
        <result column="content" property="content"/>
        <result column="created_at" property="createdAt"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <insert id="insert" parameterType="com.zhixun.item.domain.ClaimMessage"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO claim_message (claim_id, sender_id, content, deleted)
        VALUES (#{claimId}, #{senderId}, #{content}, 0)
    </insert>

    <select id="findByClaimId" resultMap="MessageResultMap">
        SELECT id, claim_id, sender_id, content, created_at, deleted
        FROM claim_message
        WHERE claim_id = #{claimId} AND deleted = 0
        <if test="beforeId != null">AND id &lt; #{beforeId}</if>
        ORDER BY id DESC
        LIMIT #{limit}
    </select>
</mapper>
