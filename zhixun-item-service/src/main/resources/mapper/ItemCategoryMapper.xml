<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhixun.item.mapper.ItemCategoryMapper">

    <resultMap id="CategoryResultMap" type="com.zhixun.item.domain.ItemCategory">
        <id column="id" property="id"/>
        <result column="code" property="code"/>
        <result column="name" property="name"/>
        <result column="parent_id" property="parentId"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="enabled" property="enabled"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <select id="findEnabled" resultMap="CategoryResultMap">
        SELECT id, code, name, parent_id, sort_order, enabled, created_at, updated_at
        FROM item_category
        WHERE enabled = 1
        ORDER BY sort_order, id
    </select>

    <select id="existsEnabledById" resultType="boolean">
        SELECT COUNT(1) &gt; 0
        FROM item_category
        WHERE id = #{id} AND enabled = 1
    </select>
</mapper>
